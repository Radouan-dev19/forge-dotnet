{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-dotnet.local/schemas/v1/lesson.schema.json",
  "title": "Leçon Forge.NET v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "week",
    "skills",
    "prerequisites",
    "estimatedMinutes",
    "objectives",
    "sections",
    "markdownPath",
    "license"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 3, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "week": { "type": "integer", "minimum": 1, "maximum": 24 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "weight"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
    },
    "estimatedMinutes": { "type": "integer", "minimum": 5, "maximum": 480 },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 10, "maxLength": 300 }
    },
    "sections": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        { "const": "intuition" },
        { "const": "explanation" },
        { "const": "example" },
        { "const": "counterExample" },
        { "const": "check" },
        { "const": "guided" },
        { "const": "independent" },
        { "const": "debugging" },
        { "const": "interview" },
        { "const": "summary" },
        { "const": "reviewCards" },
        { "const": "masteryTest" }
      ],
      "items": false
    },
    "markdownPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "minLength": 3, "maxLength": 240 },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 3, "maxLength": 80 },
    "attribution": { "type": "string", "minLength": 3, "maxLength": 300 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-dotnet.local/schemas/v1/theory-quiz.schema.json",
  "title": "Banque de quiz théorique senior Forge.NET v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "summary", "order", "questions", "license"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 3, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 40, "maxLength": 600 },
    "order": { "type": "integer", "minimum": 1, "maximum": 99 },
    "questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "prompt", "options", "correctOptionIds", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 3, "maxLength": 160 },
          "topic": { "type": "string", "minLength": 3, "maxLength": 80 },
          "prompt": { "type": "string", "minLength": 20, "maxLength": 600 },
          "options": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-e]$" },
                "text": { "type": "string", "minLength": 3, "maxLength": 300 }
              }
            }
          },
          "correctOptionIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-e]$" }
          },
          "rationale": { "type": "string", "minLength": 40, "maxLength": 1200 }
        }
      }
    },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 3, "maxLength": 80 }
  }
}

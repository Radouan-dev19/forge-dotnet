{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-dotnet.local/schemas/v1/debug.schema.json",
  "title": "Scénario de débogage Forge.NET v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "title", "difficulty", "skills", "prerequisites",
    "estimatedMinutes", "brokenRepositoryPath", "ticketPath", "expectedBehavior", "logsPath",
    "checklist", "observationQuestions", "correctionPath", "regressionTestPath", "journalFields", "license"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 3, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "skills": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" } },
    "prerequisites": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" } },
    "estimatedMinutes": { "type": "integer", "minimum": 10, "maximum": 480 },
    "brokenRepositoryPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+/$" },
    "ticketPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "expectedBehavior": { "type": "string", "minLength": 20, "maxLength": 1000 },
    "logsPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "checklist": { "type": "array", "minItems": 3, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 5, "maxLength": 300 } },
    "observationQuestions": { "type": "array", "minItems": 2, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 10, "maxLength": 500 } },
    "correctionPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+/$" },
    "regressionTestPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "journalFields": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "prefixItems": [
        { "const": "symptom" }, { "const": "context" }, { "const": "hypotheses" }, { "const": "evidence" },
        { "const": "cause" }, { "const": "fix" }, { "const": "test" }, { "const": "prevention" }
      ],
      "items": false
    },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 3, "maxLength": 80 },
    "attribution": { "type": "string", "minLength": 3, "maxLength": 300 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-dotnet.local/schemas/v1/sql.schema.json",
  "title": "Scénario SQL Forge.NET v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "title", "difficulty", "skills", "prerequisites", "estimatedMinutes",
    "image", "datasetPath", "visibleSchemaPath", "permissions", "resetScriptPath", "statementPath",
    "expectedResult", "timeoutSeconds", "maxRows", "effectAssertions", "solutionPath", "license"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 3, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "skills": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" } },
    "prerequisites": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" } },
    "estimatedMinutes": { "type": "integer", "minimum": 10, "maximum": 480 },
    "image": { "type": "string", "pattern": "^[a-z0-9./-]+@sha256:[a-f0-9]{64}$", "maxLength": 300 },
    "datasetPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "visibleSchemaPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "permissions": {
      "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
      "items": { "type": "string", "enum": ["select", "insert", "update", "delete", "execute"] }
    },
    "resetScriptPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "statementPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "expectedResult": {
      "type": "object", "additionalProperties": false,
      "required": ["ordered", "columns", "numericTolerance"],
      "properties": {
        "ordered": { "type": "boolean" },
        "columns": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" } },
        "numericTolerance": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
    "maxRows": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "effectAssertions": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 10, "maxLength": 500 } },
    "solutionPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 3, "maxLength": 80 },
    "attribution": { "type": "string", "minLength": 3, "maxLength": 300 }
  }
}

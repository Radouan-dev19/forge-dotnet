{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-dotnet.local/schemas/v1/exercise.schema.json",
  "title": "Exercice automatisable Forge.NET v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "kind",
    "difficulty",
    "skills",
    "prerequisites",
    "estimatedMinutes",
    "statement",
    "constraints",
    "examples",
    "reflectionFields",
    "starterPath",
    "visibleTestsPath",
    "hiddenTestsPath",
    "hints",
    "solution",
    "explanation",
    "complexity",
    "commonMistakes",
    "variantId",
    "reviewCards",
    "interviewQuestionId",
    "license"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 3, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "kind": { "type": "string", "enum": ["csharp", "algorithm"] },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
    },
    "estimatedMinutes": { "type": "integer", "minimum": 5, "maximum": 480 },
    "statement": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 5, "maxLength": 300 }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "output"],
        "properties": {
          "input": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "output": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "reflectionFields": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "const": "reformulation" },
        { "const": "inputs" },
        { "const": "expectedOutput" },
        { "const": "edgeCases" },
        { "const": "hypothesis" },
        { "const": "plan" }
      ],
      "items": false
    },
    "starterPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+/$" },
    "visibleTestsPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+/$" },
    "hiddenTestsPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+/$" },
    "hints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "kind", "content"],
          "properties": {
            "level": { "const": 1 },
            "kind": { "const": "socratic" },
            "content": { "type": "string", "minLength": 10, "maxLength": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "kind", "content"],
          "properties": {
            "level": { "const": 2 },
            "kind": { "const": "location" },
            "content": { "type": "string", "minLength": 10, "maxLength": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "kind", "content"],
          "properties": {
            "level": { "const": 3 },
            "kind": { "const": "strategy" },
            "content": { "type": "string", "minLength": 10, "maxLength": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "kind", "content"],
          "properties": {
            "level": { "const": 4 },
            "kind": { "const": "partial-pseudocode" },
            "content": { "type": "string", "minLength": 10, "maxLength": 1000 }
          }
        }
      ],
      "items": false
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "unlock"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+/$" },
        "unlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seriousAttempts", "minimumDelayMinutes"],
          "properties": {
            "seriousAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "minimumDelayMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
          }
        }
      }
    },
    "explanation": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "complexity": { "type": "string", "minLength": 5, "maxLength": 300 },
    "commonMistakes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 5, "maxLength": 300 }
    },
    "variantId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "reviewCards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
    },
    "interviewQuestionId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 3, "maxLength": 80 },
    "attribution": { "type": "string", "minLength": 3, "maxLength": 300 }
  }
}

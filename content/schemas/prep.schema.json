{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-dotnet.local/schemas/v1/prep.schema.json",
  "title": "Dossier de préparation d'entretien Forge.NET v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "summary", "theme", "themeTitle", "order", "documentPath", "license"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 3, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 40, "maxLength": 600 },
    "theme": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 64 },
    "themeTitle": { "type": "string", "minLength": 2, "maxLength": 120 },
    "order": { "type": "integer", "minimum": 1, "maximum": 99 },
    "documentPath": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.md$", "minLength": 4, "maxLength": 120 },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 3, "maxLength": 80 },
    "attribution": { "type": "string", "minLength": 3, "maxLength": 300 }
  }
}

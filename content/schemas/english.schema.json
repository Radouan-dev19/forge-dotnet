{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-dotnet.local/schemas/v1/english.schema.json",
  "title": "Activité d'anglais professionnel Forge.NET v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "title", "level", "durationMinutes", "skills", "situation",
    "instructions", "vocabulary", "expectedElements", "modelAnswer", "commonMistakes", "variants", "license"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 3, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "level": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
    "durationMinutes": { "type": "integer", "minimum": 5, "maximum": 120 },
    "skills": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" } },
    "situation": { "type": "string", "minLength": 20, "maxLength": 1000 },
    "instructions": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 10, "maxLength": 500 } },
    "vocabulary": {
      "type": "array", "minItems": 2, "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["term", "meaning"],
        "properties": {
          "term": { "type": "string", "minLength": 2, "maxLength": 100 },
          "meaning": { "type": "string", "minLength": 3, "maxLength": 300 }
        }
      }
    },
    "expectedElements": { "type": "array", "minItems": 2, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 5, "maxLength": 300 } },
    "modelAnswer": { "type": "string", "minLength": 30, "maxLength": 5000 },
    "commonMistakes": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 5, "maxLength": 300 } },
    "variants": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 10, "maxLength": 1000 } },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 3, "maxLength": 80 },
    "attribution": { "type": "string", "minLength": 3, "maxLength": 300 }
  }
}

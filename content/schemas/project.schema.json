{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-dotnet.local/schemas/v1/project.schema.json",
  "title": "Projet Forge.NET v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "title", "difficulty", "weeks", "skills", "prerequisites",
    "estimatedHours", "briefPath", "milestones", "rubric", "solutionPolicy", "commonMistakes", "variantIds", "license"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 3, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "weeks": { "type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 24 } },
    "skills": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" } },
    "prerequisites": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" } },
    "estimatedHours": { "type": "integer", "minimum": 1, "maximum": 300 },
    "briefPath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "milestones": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "evidence", "acceptanceCriteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 3, "maxLength": 200 },
          "evidence": { "type": "string", "minLength": 10, "maxLength": 500 },
          "acceptanceCriteria": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 10, "maxLength": 500 } }
        }
      }
    },
    "rubric": {
      "type": "array", "minItems": 2, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion", "weight", "observableEvidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 5, "maxLength": 200 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "observableEvidence": { "type": "string", "minLength": 10, "maxLength": 500 }
        }
      }
    },
    "solutionPolicy": { "const": "no-complete-solution-before-submission" },
    "commonMistakes": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 5, "maxLength": 300 } },
    "variantIds": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" } },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 3, "maxLength": 80 },
    "attribution": { "type": "string", "minLength": 3, "maxLength": 300 }
  }
}

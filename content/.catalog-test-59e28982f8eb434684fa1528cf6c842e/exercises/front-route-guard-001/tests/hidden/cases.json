{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "Hidden_NotAJwt",
      "message": "Chaine sans structure de jeton : redirection.",
      "arguments": ["not-a-jwt", "orders.read", 1000, "/x"],
      "expected": "redirect:login?return=/x",
      "expectedException": null,
      "argumentsUnchanged": false
    },
    {
      "name": "Hidden_ExpiryEqualsNow",
      "message": "Expiration egale a l'instant courant : deja expire, redirection.",
      "arguments": [
        "eyJhbGciOiJub25lIn0.eyJleHAiOjEwMDAsInNjb3BlIjoib3JkZXJzLnJlYWQifQ.sig",
        "orders.read",
        1000,
        "/o"
      ],
      "expected": "redirect:login?return=/o",
      "expectedException": null,
      "argumentsUnchanged": false
    },
    {
      "name": "Hidden_ScopeAmongMany",
      "message": "Droit exige present parmi plusieurs droits : autorise.",
      "arguments": [
        "eyJhbGciOiJub25lIn0.eyJleHAiOjIwMDAsInNjb3BlIjoiYSBiIG9yZGVycy5yZWFkIGMifQ.sig",
        "orders.read",
        1000,
        "/o2"
      ],
      "expected": "allow",
      "expectedException": null,
      "argumentsUnchanged": false
    },
    {
      "name": "Hidden_PrefixDoesNotMatch",
      "message": "orders.readonly ne satisfait pas orders.read : interdit.",
      "arguments": [
        "eyJhbGciOiJub25lIn0.eyJleHAiOjIwMDAsInNjb3BlIjoib3JkZXJzLnJlYWRvbmx5In0.sig",
        "orders.read",
        999,
        "/o3"
      ],
      "expected": "forbidden",
      "expectedException": null,
      "argumentsUnchanged": false
    },
    {
      "name": "Hidden_NullPathThrows",
      "message": "Chemin courant absent : ArgumentNullException.",
      "arguments": [
        "eyJhbGciOiJub25lIn0.eyJleHAiOjIwMDAsInNjb3BlIjoib3JkZXJzLnJlYWQifQ.sig",
        "orders.read",
        1000,
        null
      ],
      "expectedException": "ArgumentNullException",
      "argumentsUnchanged": false
    },
    {
      "name": "Hidden_BadBase64Redirects",
      "message": "Segment du milieu illisible en base64url : redirection.",
      "arguments": ["aaa.@@@.bbb", "orders.read", 1000, "/z"],
      "expected": "redirect:login?return=/z",
      "expectedException": null,
      "argumentsUnchanged": false
    }
  ]
}

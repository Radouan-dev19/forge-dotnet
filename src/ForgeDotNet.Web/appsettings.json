{
  "LocalData": {
    "DatabaseFileName": "forge-dotnet.db"
  },
  "Diagnostic": {
    "InitialSectionDurationMinutes": 30,
    "ReducedSectionDurationSeconds": 120
  },
  "CodeRunner": {
    "Mode": "Manual",
    "DeterministicScenarios": "Unavailable",
    "DeterministicDelayMilliseconds": 0,
    "Docker": {
      "ExecutablePath": "docker",
      "Context": "desktop-linux",
      "ImageReference": "",
      "MaximumConcurrency": 2,
      "CpuCount": 1.0,
      "MemoryBytes": 536870912,
      "PidsLimit": 64,
      "WorkspaceBytes": 67108864,
      "CompilationTimeoutSeconds": 25,
      "TestTimeoutSeconds": 30,
      "ControlTimeoutSeconds": 15
    }
  },
  "SqlLab": {
    "Enabled": false,
    "Server": "127.0.0.1",
    "Port": 14333,
    "AdministratorUser": "sa",
    "Encrypt": true,
    "TrustServerCertificate": true,
    "ConnectTimeoutSeconds": 15,
    "QueryTimeoutSeconds": 3,
    "MaximumRows": 100,
    "MaximumResultBytes": 65536,
    "MaximumQueryCharacters": 16384,
    "MaximumSessions": 4,
    "MaximumConcurrency": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

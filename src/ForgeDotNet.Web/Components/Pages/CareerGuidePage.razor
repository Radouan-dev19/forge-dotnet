@page "/career/{GuideId}"
@using ForgeDotNet.Application.Preparation
@using ForgeDotNet.Domain.Career
@inject ICareerGuideSource Guides

<PageTitle>@(_guide?.Title ?? "Guide de carrière") — Forge.NET</PageTitle>

@if (_error is not null)
{
    <p class="error-message" role="alert">@_error</p>
}
else if (_guide is null)
{
    <p role="status">Chargement du guide…</p>
}
else
{
    <h1>@_guide.Title</h1>
    <p>@_guide.Summary</p>
    <p class="notice" role="status">
        Ce guide ne produit aucune preuve de maîtrise et ne promet ni emploi ni salaire : il se lit, puis
        s'applique hors du produit, dans vos propres fichiers.
    </p>

    <section class="practice-panel" aria-labelledby="career-guide-body-title">
        <h2 id="career-guide-body-title">Guide</h2>
        <pre class="runner-output">@_guide.Body</pre>
    </section>

    <p><a href="/career">Retour au kit carrière</a></p>
}

@code {
    [Parameter]
    public string GuideId { get; set; } = string.Empty;

    private CareerGuide? _guide;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _guide = await Guides.GetAsync(GuideId);
            _error = _guide is null ? "Guide de carrière introuvable." : null;
        }
        catch (Exception exception) when (exception is InvalidDataException or InvalidOperationException)
        {
            _error = exception.Message;
        }
    }
}
